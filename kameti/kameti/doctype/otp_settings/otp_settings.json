   "description": "Template language code.",
   "fieldname": "whatsapp_otp_template_lang",
   "fieldtype": "Data",
   "label": "WhatsApp OTP Template Language"
  },
  {
   "depends_on": "eval:doc.provider=='whatsapp' && doc.whatsapp_backend=='ultramsg'",
   "description": "UltraMsg instance id, e.g. instance182401.",
   "fieldname": "ultramsg_instance_id",
   "fieldtype": "Data",
   "label": "UltraMsg Instance ID"
  },
  {
