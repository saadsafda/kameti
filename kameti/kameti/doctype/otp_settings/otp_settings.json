 "fields": [
  {
   "fieldname": "delivery_section",
   "fieldtype": "Section Break",
   "label": "Delivery"
  },
  {
   "default": "console",
   "description": "console = store plaintext in Phone OTP doctype, skip sending. Switch to whatsapp/sms once provider credentials are configured.",
   "fieldname": "provider",
   "fieldtype": "Select",
   "label": "Provider",
   "options": "console\nwhatsapp\nsms",
   "reqd": 1
  },
  {
   "default": "0",
   "description": "When on, every console-mode OTP uses the fixed code below (handy for app development). When off, a random 6-digit code is generated.",
   "fieldname": "use_fixed_dev_code",
   "fieldtype": "Check",
   "label": "Use Fixed Dev Code"
  },
  {
   "default": "472901",
   "depends_on": "eval:doc.use_fixed_dev_code",
   "fieldname": "fixed_dev_code",
   "fieldtype": "Data",
   "label": "Fixed Dev Code",
   "length": 6
  },
  {
   "fieldname": "limits_section",
   "fieldtype": "Section Break",
   "label": "Limits"
  },
  {
   "default": "300",
   "description": "How long a code is valid for, in seconds.",
   "fieldname": "otp_ttl_seconds",
   "fieldtype": "Int",
   "label": "OTP TTL (seconds)",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "default": "5",
   "description": "Lock the code after this many wrong tries.",
   "fieldname": "max_attempts",
   "fieldtype": "Int",
   "label": "Max Attempts",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "fieldname": "column_break_limits",
   "fieldtype": "Column Break"
  },
  {
   "default": "60",
   "description": "Minimum seconds between consecutive OTP requests for the same phone.",
   "fieldname": "resend_interval_seconds",
   "fieldtype": "Int",
   "label": "Resend Interval (seconds)",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "default": "5",
   "description": "Maximum OTP requests per phone per hour.",
   "fieldname": "hourly_limit",
   "fieldtype": "Int",
   "label": "Hourly Limit",
   "non_negative": 1,
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.provider=='whatsapp'",
   "fieldname": "whatsapp_section",
   "fieldtype": "Section Break",
   "label": "WhatsApp"
  },
  {
   "default": "meta",
   "depends_on": "eval:doc.provider=='whatsapp'",
   "description": "Which WhatsApp backend to send through. meta = official Cloud API (configure the fields below). vonage / ultramsg = free-form text only.",
   "fieldname": "whatsapp_backend",
   "fieldtype": "Select",
   "label": "WhatsApp Backend",
   "options": "meta\nvonage\nultramsg"
  },
  {
   "depends_on": "eval:doc.provider=='whatsapp' && doc.whatsapp_backend=='meta'",
   "description": "Meta Cloud API phone_number_id from the WhatsApp app.",
   "fieldname": "whatsapp_phone_number_id",
   "fieldtype": "Data",
   "label": "WhatsApp Phone Number ID"
  },
  {
   "depends_on": "eval:doc.provider=='whatsapp' && doc.whatsapp_backend=='meta'",
   "description": "Meta Cloud API access token. Stored encrypted.",
   "fieldname": "whatsapp_access_token",
   "fieldtype": "Password",
   "label": "WhatsApp Access Token"
  },
  {
   "default": "v18.0",
   "depends_on": "eval:doc.provider=='whatsapp' && doc.whatsapp_backend=='meta'",
